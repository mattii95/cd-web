# Copiá este archivo a `.env` (lo lee docker compose) y creá `.env.local` con DATABASE_URL.

# Lee docker compose (.env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=DB_CD26

# Desarrollo (.env.local)
DATABASE_URL=postgres://postgres:cambiame@localhost:5432/DB_CD26

# Test (.env.test.local):
# DATABASE_URL=postgres://postgres:cambiame@localhost:5432/DB_CD26_test
