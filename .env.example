# Copiá este archivo a `.env` (lo lee docker compose) y creá `.env.local` con DATABASE_URL.

# Lee docker compose (.env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=DB_CD26

# Desarrollo (.env.local)
DATABASE_URL=postgres://postgres:cambiame@localhost:5432/DB_CD26

# Test (.env.test.local):
# DATABASE_URL=postgres://postgres:cambiame@localhost:5432/DB_CD26_test

# Auth (.env.local y .env.test.local)
# Secret: openssl rand -base64 32
BETTER_AUTH_SECRET=cambiame-por-un-secret-de-32-caracteres-o-mas
BETTER_AUTH_URL=http://localhost:3000

# Email (.env.local). En desarrollo apunta a Mailpit (http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Courroux Digital <no-reply@localhost>"

# Login con proveedores OAuth (.env.local). Todas opcionales: sin credenciales no se muestra el botón.
# En .env.test.local y CI usá valores falsos (test-google-id, test-google-secret, etc.).
# Callback: {BETTER_AUTH_URL}/api/auth/callback/{google|github|microsoft}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# IP real del cliente para el rate limit (.env.local y producción). Opcional, pero sin ella
# todos comparten un único bucket. Poné SOLO el header que agrega tu proxy: cualquier otro
# lo puede falsificar el cliente y saltearía el límite.
#   Cloudflare            → cf-connecting-ip
#   Nginx / Caddy propio  → x-real-ip (o x-forwarded-for si el proxy lo agrega al final)
#   Vercel / otro balanceador que agrega a x-forwarded-for → x-forwarded-for
# Valores válidos: x-forwarded-for, x-real-ip, cf-connecting-ip. Vacío en desarrollo.
# TRUSTED_IP_HEADER=

# Cloudflare Turnstile en login, registro, recuperar y reenviar verificación.
# Fuera de producción, si faltan, se usan las claves de prueba oficiales (siempre pasan).
# En producción son obligatorias. Se crean en https://dash.cloudflare.com → Turnstile.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY se incrusta en el build: definila antes de `npm run build`.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Carpeta de las imágenes subidas (.env.local, .env.test.local y producción).
# Default: storage/media, relativo a la raíz del repo. Tiene que ser una carpeta persistente.
# MEDIA_DIR=storage/media
# En .env.test.local y CI: MEDIA_DIR=test-results/media

# Seed del blog (.env.local, solo lo lee `npm run db:seed`).
# El usuario tiene que estar registrado antes de correr el seed.
SEED_AUTHOR_EMAIL=autor@ejemplo.com
